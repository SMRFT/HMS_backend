# Use official Python runtime as a parent image
FROM python:3.11-slim-bookworm

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies required for OCR, PDF processing, and compiling libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    poppler-utils \
    gcc \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Copy ONLY requirements.txt and install all Python libraries
COPY requirements.txt /app/
RUN pip install --upgrade pip && pip install -r requirements.txt

# ==============================================================================
# NOTE: We intentionally DO NOT copy the HMS backend source code (COPY . /app/)!
# This Docker image contains ONLY the installed libraries & OS dependencies.
# When running via docker-compose, your live code is mounted via volume (- .:/app).
# ==============================================================================

# Expose the Django port
EXPOSE 2609

# Start Django development server using the dynamically mounted source code
CMD ["python3", "manage.py", "runserver", "0.0.0.0:2609"]
